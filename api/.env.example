# Database
DATABASE_URL="postgresql://user:password@localhost:5432/paidinfull?schema=public"
# DATABASE_CONNECTION_LIMIT=10

# Sentry (error monitoring + performance tracing) — leave unset to disable
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_HOT_PATH_SAMPLE_RATE=0.5

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS=
PLATFORM_OPS_EMAIL=

# Monnify — disbursement + collections rail. Sandbox: https://sandbox.monnify.com
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_ENCRYPTION_KEY="change-me-to-a-long-random-value"
MONNIFY_MOCK_MODE="true"
# Webhook signatures (HMAC-SHA512 of the raw body with MONNIFY_SECRET_KEY) are required for live traffic.
# Set to "false" only as a temporary escape hatch; unsigned events are then re-verified with Monnify.
# MONNIFY_ENFORCE_WEBHOOK_SIGNATURE="true"
MONNIFY_WEBHOOK_BASE_URL="http://localhost:3000"
# Set these two only if disbursement calls need to go through monnify-relay/ for static-IP
# whitelisting (see monnify-relay/README.md) — leave both unset to call Monnify directly.
MONNIFY_RELAY_URL=
MONNIFY_RELAY_SHARED_SECRET=

# Resend (email)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL="Paid in Full <noreply@paidinfull.app>"
FRONTEND_URL="http://localhost:5173"
BRAND_WEBSITE_URL="https://www.paidinfull.app"

# Google OAuth (optional social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Google Sheets (invoice/receivables reconciliation)
GOOGLE_SHEETS_CREDENTIALS_BASE64=
# Dev: log Google Sheets rows instead of sending them (a sheet URL must still be configured)
SHEETS_MOCK_MODE=false

# WhatsApp Cloud API (Meta direct integration) — leave unset to run in mock mode
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SUPPORT_PHONE=

# AI (COA suggestion / description cleanup / expense parsing) — DeepSeek used if OpenAI key unset
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Web push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:ops@paidinfull.app"
