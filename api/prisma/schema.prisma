  status             CreditStatus @default(OPEN)
  appliedToInvoiceId String?      @map("applied_to_invoice_id")
  appliedAt          DateTime?    @map("applied_at")
  sourceInvoiceId    String?      @map("source_invoice_id")
  createdAt          DateTime     @default(now()) @map("created_at")

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appliedToInvoice Invoice?  @relation("CreditAppliedTo", fields: [appliedToInvoiceId], references: [id], onDelete: SetNull)
