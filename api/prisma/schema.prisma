generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Conventions
// - camelCase fields, snake_case columns via @map.
// - Money is Decimal(14,2). Rates stored as fractions 0-1 are Decimal(6,4) (WHT); invoice VAT/WHT
//   line percentages are Decimal(5,2) percents (7.5 = 7.5%).
// - Period months (budgets, P&L) are "YYYY-MM" strings.
// - Snapshot columns (vendorName, coaTag, payCategoryName, ...) are copied at write time so history
//   survives renames; the matching *Id column is the live link.

// ─── Enums ──────────────────────────────────────────────────────────────────

enum PlanTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

/// Lifecycle of a client workspace as managed from the super-admin console (spec §14).
enum WorkspaceStatus {
  LEAD
  TRIAL
  ACTIVE
  DEAD
  PAUSED
  SUSPENDED
}

/// One primary role per member. Precedence: ADMIN > PAYER > APPROVER > POSTER > PROCUREMENT >
/// REQUESTER > VIEWER. Biller is an add-on flag (WorkspaceMember.isBiller), not a role.
/// Mirrors api/src/common/decorators/roles.decorator.ts Role enum.
enum WorkspaceRole {
  VIEWER
  REQUESTER
  PROCUREMENT
  POSTER
  APPROVER
  PAYER
  ADMIN
}

/// PIF staff roles (User.platformRole). Not workspace-scoped.
enum PlatformRole {
  SUPER_ADMIN
  CLIENT_SETUP
}

enum MandateStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  PROCUREMENT_CLEARED
  RETURNED
  QUEUED
  REJECTED
}

enum QueueItemStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// batches.payout_status
enum BatchPayoutStatus {
  PENDING
  PROCESSING
  PARTIAL
  SUCCESS
  CANCELLED
}

/// batch_items.payout_status
enum BatchItemPayoutStatus {
  PENDING
  SENDING
  SUCCESS
  FAILED
  REVERSED
  CANCELLED
  SKIPPED
}

/// Status of one transfer leg in the payout ledger (BatchItemPayout), and of wallet top-ups.
enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PayoutLeg {
  VENDOR
  WHT
}

enum WalletTransactionType {
  TOPUP
  SWEEP_IN
  DISBURSEMENT
  FEE
  REFUND
  ADJUSTMENT
  WHT_WITHHOLDING
}

enum LedgerDirection {
  IN
  OUT
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum TopupSource {
  WEBHOOK
  MANUAL_RECONCILIATION
  CARD
}

enum FundingWaitStatus {
  WAITING
  FUNDED
  CANCELLED
}

enum InvoiceDocType {
  INVOICE
  QUOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum DiscountType {
  PERCENT
  FLAT
}

enum CreditStatus {
  OPEN
  APPLIED
  REFUNDED
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum CustomerSubscriptionStatus {
  PENDING_MANDATE
  ACTIVE
  CANCELLED
}

enum MandateType {
  CARD
  DIRECT_DEBIT
}

enum ChargeStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SettlementItemStatus {
  MATCHED
  UNMATCHED
  DISPUTED
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

// ─── Workspace / Auth ───────────────────────────────────────────────────────

model Workspace {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logoUrl  String? @map("logo_url")
  currency String  @default("NGN")
  timezone String  @default("Africa/Lagos")
  industry String?
  tin      String? // workspace_tin, printed on invoices / WHT reports

  // Super-admin console (spec §14)
  status        WorkspaceStatus @default(TRIAL)
  tier          String?
  monthlyAmount Decimal?        @map("monthly_amount") @db.Decimal(14, 2)
  billingDay    Int?            @map("billing_day")
  paidUntil     DateTime?       @map("paid_until")
  nextDueDate   DateTime?       @map("next_due_date")
  notes         String?

  planTier            PlanTier           @default(STARTER) @map("plan_tier")
  subscriptionStatus  SubscriptionStatus @default(TRIALING) @map("subscription_status")
  trialEndDate        DateTime?          @map("trial_end_date")
  subscriptionEndDate DateTime?          @map("subscription_end_date")
  isGrandfathered     Boolean            @default(false) @map("is_grandfathered")

  businessType String? @map("business_type")

  // Monnify wallet: a workspace disburses out of its own reserved virtual account, funded by
  // transfer; see WalletLedgerEntry/WalletTopup/WalletSweep.
  monnifyReservedAccountNumber String? @map("monnify_reserved_account_number")
  monnifyReservedAccountName   String? @map("monnify_reserved_account_name")
  monnifyReservedAccountBank   String? @map("monnify_reserved_account_bank")
  monnifyReservedAccountRef    String? @map("monnify_reserved_account_ref")
  monnifyContractCode          String? @map("monnify_contract_code")

  invoicePrefix String  @default("INV") @map("invoice_prefix")
  taxRate       Decimal @default(7.5) @map("tax_rate") @db.Decimal(5, 2)

  // PIF's own subscription billing NUBAN (spec §5.10 #17): a dedicated reserved account the client
  // pays its PIF fee into. Separate from the disbursement wallet above.
  billingAccountNumber String? @map("billing_account_number")
  billingAccountName   String? @map("billing_account_name")
  billingAccountBank   String? @map("billing_account_bank")
  billingAccountRef    String? @map("billing_account_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members               WorkspaceMember[]
  clientMandates        ClientMandate[]
  clientMandateInvites  ClientMandateInvite[]
  vendors               Vendor[]
  costCenters           CostCenter[]
  departments           Department[]
  locations             Location[]
  payCategories         PayCategory[]
  coaTags               CoaTag[]
  budgets               Budget[]
  requisitions          Requisition[]
  queueItems            QueueItem[]
  queueItemAttachments  QueueItemAttachment[]
  recurringPayments     RecurringPayment[]
  batches               Batch[]
  batchItemPayouts      BatchItemPayout[]
  walletLedgerEntries   WalletLedgerEntry[]
  walletTopups          WalletTopup[]
  walletSweeps          WalletSweep[]
  payoutFundingWaits    PayoutFundingWait[]
  whtRates              WhtRate[]
  whtLedgerEntries      WhtLedger[]
  customers             Customer[]
  customerCredits       CustomerCredit[]
  invoiceTemplates      InvoiceTemplate[]
  invoices              Invoice[]
  invoiceRecurrences    InvoiceRecurrence[]
  invoiceSequences      InvoiceSequence[]
  products              Product[]
  stockExpenses         StockExpense[]
  customerSubscriptions CustomerSubscription[]
  settlementBatches     SettlementBatch[]
  subscription          WorkspaceSubscription?
  notificationPrefs     NotificationPref[]
  pushSubscriptions     PushSubscription[]
  auditLogs             AuditLog[]
  appConfig             AppConfig[]
  idempotencyKeys       IdempotencyKey[]

  // Lovable migration additions
  sessionTimeoutMinutes        Int                   @default(60) @map("session_timeout_minutes")
  requireReauthForDisbursement Boolean               @default(false) @map("require_reauth_for_disbursement")
  createdById                  String?               @map("created_by_id")
  signatureUrl                 String?               @map("signature_url")
  themeColor                   String?               @map("theme_color")
  invoiceFooter                String?               @map("invoice_footer")
  payoutNarrationName          String?               @map("payout_narration_name")
  procurementApprovers         ProcurementApprover[]
  requisitionApprovals         RequisitionApproval[]
  goodsReceipts                GoodsReceipt[]

  @@map("workspaces")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  phone        String?

  // profile (spec §4 profiles). PIN hash lives in UserSecurity and is never sent to the client.
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  accentSkin  String  @default("default") @map("accent_skin") // "default" (turquoise) | "classic" (gold)
  onboarded   Boolean @default(false)

  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  isActive        Boolean       @default(true) @map("is_active")
  /// PIF staff role. SUPER_ADMIN implies isPlatformAdmin in CurrentUserData.
  platformRole    PlatformRole? @map("platform_role")
  /// Google account subject (sign-in with Google). Null until the user first signs in with Google.
  googleSub       String?       @map("google_sub")
  /// False for accounts created via Google / invite that have never chosen a password.
  hasPassword     Boolean       @default(true) @map("has_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships             WorkspaceMember[]
  clientMandates          ClientMandate[]
  security                UserSecurity?
  emailVerificationTokens EmailVerificationToken[]
  requisitionsRequested   Requisition[]            @relation("RequisitionRequestedBy")
  queueItemsCreated       QueueItem[]
  queueItemComments       QueueItemComment[]
  queueItemAttachments    QueueItemAttachment[]
  batchesCreated          Batch[]                  @relation("BatchCreatedBy")
  batchesApproved         Batch[]                  @relation("BatchApprovedBy")
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]

  procurementApprovals      ProcurementApprover[]
  requisitionApprovalsGiven RequisitionApproval[] @relation("RequisitionApprovalApprover")

  @@map("users")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  token       String    @unique
  type        String // EMAIL_VERIFY | PASSWORD_RESET | MAGIC_LINK | INVITE
  /// INVITE tokens: the workspace the invite is for.
  workspaceId String?   @map("workspace_id")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model UserSecurity {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  pinHash             String?   @map("pin_hash")
  pinSetAt            DateTime? @map("pin_set_at")
  idleLogoutMinutes   Int       @default(15) @map("idle_logout_minutes")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  pinFailedAttempts   Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil      DateTime? @map("pin_locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_security")
}

// Membership + role of a User within a Workspace: the primary access-control row (spec
// workspace_members + user_roles). joinedAt = null means "invited, not yet accepted".
model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(VIEWER)
  /// Biller add-on: grants the Invoices module (canInvoice) on top of `role`.
  isBiller    Boolean       @default(false) @map("is_biller")
  isActive    Boolean       @default(true) @map("is_active")
  invitedAt   DateTime      @default(now()) @map("invited_at")
  invitedById String?       @map("invited_by_id")
  joinedAt    DateTime?     @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// An external accountant/bookkeeper granted scoped access to a client workspace.
model ClientMandate {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(APPROVER)
  status      MandateStatus @default(ACTIVE)
  grantedAt   DateTime      @default(now()) @map("granted_at")
  revokedAt   DateTime?     @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("client_mandates")
}

model ClientMandateInvite {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  email       String
  role        WorkspaceRole @default(APPROVER)
  token       String        @unique
  status      MandateStatus @default(INVITED)
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("client_mandate_invites")
}

// ─── Vendors, spend structure, budgets ──────────────────────────────────────

model Vendor {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  name                 String
  contactPerson        String?   @map("contact_person")
  phone                String?
  email                String?
  bankAccountNumber    String?   @map("bank_account_number") // 10-digit NUBAN
  bankCode             String?   @map("bank_code") // CBN bank code
  bankName             String?   @map("bank_name")
  accountName          String?   @map("account_name") // as typed by the user
  verifiedAccountName  String?   @map("verified_account_name") // from name enquiry
  verifiedAt           DateTime? @map("verified_at")
  isBankVerified       Boolean   @default(false) @map("is_bank_verified")
  monnifyRecipientCode String?   @map("monnify_recipient_code")
  tin                  String?
  tags                 String[]  @default([])
  whtExempt            Boolean   @default(false) @map("wht_exempt")
  /// Vendor-level WHT override as a fraction (0.05 = 5%). Null/0 = no override.
  whtRate              Decimal?  @map("wht_rate") @db.Decimal(6, 4)
  isActive             Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requisitions      Requisition[]
  queueItems        QueueItem[]
  batchItems        BatchItem[]
  whtLedgerEntries  WhtLedger[]
  stockExpenses     StockExpense[]
  recurringPayments RecurringPayment[]

  // Lovable migration additions
  notifyChannel String  @default("whatsapp") @map("notify_channel")
  notifyOptIn   Boolean @default(true) @map("notify_opt_in")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("vendors")
}

// Business Unit (spec cost_centers).
model CostCenter {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  code        String? // e.g. YD, LR, AM
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  locations         Location[]
  requisitions      Requisition[]
  queueItems        QueueItem[]
  batchItems        BatchItem[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]

  // Lovable migration additions
  color        String?
  hasLocations Boolean  @default(false) @map("has_locations")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("cost_centers")
}

model Department {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  name        String
  isActive    Boolean @default(true) @map("is_active")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requisitions Requisition[]

  @@unique([workspaceId, name])
  @@map("departments")
}

// BU Head (spec locations), a child of a Business Unit. isGeneral = the "✦ General (split)" head.
model Location {
  id           String  @id @default(uuid())
  workspaceId  String  @map("workspace_id")
  costCenterId String? @map("cost_center_id")
  name         String
  address      String?
  isGeneral    Boolean @default(false) @map("is_general")
  sortOrder    Int     @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  requisitions      Requisition[]
  queueItems        QueueItem[]
  batchItems        BatchItem[]
  recurringPayments RecurringPayment[]

  // Lovable migration additions
  code      String?
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, costCenterId, name])
  @@index([costCenterId])
  @@map("locations")
}

// Payment category (OPEX, ASSET, PROJECT, PROPERTY, COS...). Each has its own COA tags.
model PayCategory {
  id               String  @id @default(uuid())
  workspaceId      String  @map("workspace_id")
  name             String
  code             String?
  color            String  @default("#22D3EE")
  sortOrder        Int     @default(0) @map("sort_order")
  includeInBudgets Boolean @default(false) @map("include_in_budgets")
  isActive         Boolean @default(true) @map("is_active")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coaTags           CoaTag[]
  requisitions      Requisition[]
  queueItems        QueueItem[]
  batches           Batch[]
  batchItems        BatchItem[]
  stockExpenses     StockExpense[]
  recurringPayments RecurringPayment[]

  // Lovable migration additions
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("pay_categories")
}

// Chart-of-accounts tag, scoped to a payment category (replaces spec app_config.coa_by_category).
model CoaTag {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  payCategoryId String   @map("pay_category_id")
  name          String
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payCategory       PayCategory        @relation(fields: [payCategoryId], references: [id], onDelete: Cascade)
  budgets           Budget[]
  requisitions      Requisition[]
  queueItems        QueueItem[]
  batchItems        BatchItem[]
  stockExpenses     StockExpense[]
  recurringPayments RecurringPayment[]

  @@unique([payCategoryId, name])
  @@index([workspaceId])
  @@map("coa_tags")
}

// Monthly cap per (period month, BU, COA tag). costCenterId null = workspace-wide (no BU).
// NB: Postgres treats NULLs as distinct in the unique index, so for null-BU rows use
// findFirst + update/create rather than upsert on the compound key.
model Budget {
  id            String  @id @default(uuid())
  workspaceId   String  @map("workspace_id")
  periodMonth   String  @map("period_month") // YYYY-MM
  costCenterId  String? @map("cost_center_id")
  coaTagId      String  @map("coa_tag_id")
  monthlyAmount Decimal @map("monthly_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  coaTag     CoaTag      @relation(fields: [coaTagId], references: [id], onDelete: Cascade)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  payCategoryId String? @map("pay_category_id")
  locationId    String? @map("location_id")

  @@unique([workspaceId, periodMonth, costCenterId, coaTagId])
  @@index([workspaceId, periodMonth])
  @@map("budgets")
}

// Reusable line items ("Stock") that pre-fill add forms.
model StockExpense {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  name          String
  description   String?
  payCategoryId String?  @map("pay_category_id")
  coaTagId      String?  @map("coa_tag_id")
  vendorId      String?  @map("vendor_id")
  unitName      String?  @map("unit_name")
  unitAmount    Decimal  @default(0) @map("unit_amount") @db.Decimal(14, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payCategory PayCategory? @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  coaTag      CoaTag?      @relation(fields: [coaTagId], references: [id], onDelete: SetNull)
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@map("stock_expenses")
}

// ─── Requisition → Queue → Batch → Payout loop ─────────────────────────────

model Requisition {
  id                String            @id @default(uuid())
  workspaceId       String            @map("workspace_id")
  reqRef            String?           @map("req_ref")
  date              DateTime          @default(now()) @db.Date
  departmentId      String?           @map("department_id")
  departmentName    String?           @map("department_name")
  requestedById     String            @map("requested_by_id") // requester_user_id
  requesterName     String?           @map("requester_name")
  // vendor: either from the register (vendorId) or a new vendor typed in (isNewVendor + vendor* fields)
  vendorId          String?           @map("vendor_id")
  isNewVendor       Boolean           @default(false) @map("is_new_vendor")
  vendorName        String?           @map("vendor_name")
  vendorBank        String?           @map("vendor_bank")
  vendorBankCode    String?           @map("vendor_bank_code")
  vendorAcctNo      String?           @map("vendor_acct_no")
  vendorAcctName    String?           @map("vendor_acct_name")
  description       String
  units             Decimal           @default(1) @db.Decimal(12, 3)
  unitName          String?           @map("unit_name")
  unitAmount        Decimal           @default(0) @map("unit_amount") @db.Decimal(14, 2)
  total             Decimal           @default(0) @db.Decimal(14, 2)
  bundleId          String?           @map("bundle_id")
  bundleLabel       String?           @map("bundle_label")
  costCenterId      String?           @map("cost_center_id")
  locationId        String?           @map("location_id")
  payCategoryId     String?           @map("pay_category_id")
  coaTagId          String?           @map("coa_tag_id")
  reason            String?
  remarks           String?
  reviewNote        String?           @map("review_note")
  attachmentGroupId String?           @map("attachment_group_id")
  status            RequisitionStatus @default(DRAFT)
  submittedAt       DateTime?         @map("submitted_at")
  clearedAt         DateTime?         @map("cleared_at")
  clearedById       String?           @map("cleared_by_id")
  returnedAt        DateTime?         @map("returned_at")
  returnedById      String?           @map("returned_by_id")
  rejectedAt        DateTime?         @map("rejected_at")
  rejectedById      String?           @map("rejected_by_id")
  rejectionReason   String?           @map("rejection_reason")
  queuedAt          DateTime?         @map("queued_at")
  queuedById        String?           @map("queued_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User         @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payCategory PayCategory? @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  coaTag      CoaTag?      @relation(fields: [coaTagId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  queueItem   QueueItem?

  // Lovable migration additions
  hodName           String?               @map("hod_name")
  staffAccountNote  String?               @map("staff_account_note")
  pnlPeriod         String?               @map("pnl_period")
  finalApprovedById String?               @map("final_approved_by_id")
  finalApprovedAt   DateTime?             @map("final_approved_at")
  approvalRound     Int                   @default(0) @map("approval_round")
  approvals         RequisitionApproval[]
  goodsReceipt      GoodsReceipt?

  @@unique([workspaceId, reqRef])
  @@index([workspaceId, status])
  @@index([workspaceId, bundleId])
  @@map("requisitions")
}

// One payable line in the payment queue. Bundles = several queue items sharing bundleId/bundleLabel
// (each sub-item pays its own vendor).
model QueueItem {
  id                String          @id @default(uuid())
  workspaceId       String          @map("workspace_id")
  date              DateTime        @default(now()) @db.Date
  vendorId          String          @map("vendor_id")
  vendorName        String?         @map("vendor_name")
  description       String
  units             Decimal         @default(1) @db.Decimal(12, 3)
  unitName          String?         @map("unit_name")
  unitAmount        Decimal         @default(0) @map("unit_amount") @db.Decimal(14, 2)
  total             Decimal         @db.Decimal(14, 2)
  // WHT (spec §6): gross = round(total), wht = round(gross × rate), net = gross − wht
  whtRate           Decimal         @default(0) @map("wht_rate") @db.Decimal(6, 4)
  whtAmount         Decimal         @default(0) @map("wht_amount") @db.Decimal(14, 2)
  netAmount         Decimal         @default(0) @map("net_amount") @db.Decimal(14, 2)
  whtOverride       Boolean         @default(false) @map("wht_override")
  whtSource         String?         @map("wht_source")
  payCategoryId     String?         @map("pay_category_id")
  payCategoryName   String?         @map("pay_category")
  coaTagId          String?         @map("coa_tag_id")
  coaTag            String?         @map("coa_tag")
  costCenterId      String?         @map("cost_center_id")
  locationId        String?         @map("location_id")
  pnlPeriod         String?         @map("pnl_period") // YYYY-MM activity/accrual month
  isUrgent          Boolean         @default(false) @map("is_urgent")
  bundleId          String?         @map("bundle_id")
  bundleLabel       String?         @map("bundle_label")
  recurrenceId      String?         @map("recurrence_id")
  requisitionId     String?         @unique @map("requisition_id")
  sourceInvoiceId   String?         @map("source_invoice_id")
  attachmentGroupId String?         @map("attachment_group_id")
  invoiceNumber     String?         @map("invoice_number")
  invoiceDate       DateTime?       @map("invoice_date")
  status            QueueItemStatus @default(PENDING)
  budgetFlag        Boolean         @default(false) @map("budget_flag")
  createdById       String          @map("created_by_id")
  createdByName     String?         @map("created_by_name")
  requestedByName   String?         @map("requested_by_name")
  approvedAt        DateTime?       @map("approved_at")
  approvedById      String?         @map("approved_by_id")
  rejectedReason    String?         @map("rejected_reason")
  rejectedById      String?         @map("rejected_by_id")
  rejectedAt        DateTime?       @map("rejected_at")
  syncedToSheets    Boolean         @default(false) @map("synced_to_sheets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requisition Requisition?          @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  vendor      Vendor                @relation(fields: [vendorId], references: [id])
  payCategory PayCategory?          @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  coaTagRef   CoaTag?               @relation(fields: [coaTagId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  location    Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  recurrence  RecurringPayment?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  createdBy   User                  @relation(fields: [createdById], references: [id])
  attachments QueueItemAttachment[]
  comments    QueueItemComment[]
  batchItems  BatchItem[]

  // Lovable migration additions
  budgetTag String? @map("budget_tag")

  @@index([workspaceId, status])
  @@index([workspaceId, bundleId])
  @@index([workspaceId, vendorId])
  @@map("queue_items")
}

// Files shared by requisitions and queue items through attachmentGroupId.
model QueueItemAttachment {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  attachmentGroupId String   @map("attachment_group_id")
  queueItemId       String?  @map("queue_item_id")
  storagePath       String   @map("storage_path")
  fileUrl           String?  @map("file_url")
  fileName          String   @map("file_name")
  mimeType          String?  @map("mime_type")
  sizeBytes         Int?     @map("size_bytes")
  uploadedById      String   @map("uploaded_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  queueItem  QueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([attachmentGroupId])
  @@index([queueItemId])
  @@map("queue_item_attachments")
}

model QueueItemComment {
  id          String   @id @default(uuid())
  queueItemId String   @map("queue_item_id")
  userId      String   @map("user_id")
  authorName  String?  @map("author_name")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  queueItem QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([queueItemId])
  @@map("queue_item_comments")
}

// Enqueued 7 days before dayOfMonth (29–31 clamp to month end); urgent within urgentDays.
model RecurringPayment {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  vendorId      String    @map("vendor_id")
  description   String
  amount        Decimal   @db.Decimal(14, 2)
  dayOfMonth    Int       @map("day_of_month")
  urgentDays    Int       @default(2) @map("urgent_days")
  payCategoryId String?   @map("pay_category_id")
  coaTagId      String?   @map("coa_tag_id")
  costCenterId  String?   @map("cost_center_id")
  locationId    String?   @map("location_id")
  isActive      Boolean   @default(true) @map("is_active")
  lastChargedAt DateTime? @map("last_charged_at")
  nextRunDate   DateTime? @map("next_run_date") @db.Date
  createdById   String?   @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payCategory PayCategory? @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  coaTag      CoaTag?      @relation(fields: [coaTagId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  queueItems  QueueItem[]

  @@index([workspaceId, isActive])
  @@map("recurring_payments")
}

// One batch per payment category per approval. batchRef = "{CAT4} BATCH {YY}{MM}{SEQ3}[-n]".
model Batch {
  id               String            @id @default(uuid())
  workspaceId      String            @map("workspace_id")
  batchRef         String            @map("batch_ref")
  payCategoryId    String?           @map("pay_category_id")
  payCategoryName  String?           @map("pay_cat")
  payCategoryColor String?           @map("pay_cat_color")
  date             DateTime          @default(now()) @db.Date
  total            Decimal           @db.Decimal(14, 2)
  payoutStatus     BatchPayoutStatus @default(PENDING) @map("payout_status")
  isManual         Boolean           @default(false) @map("is_manual")
  createdById      String            @map("created_by_id")
  approvedById     String?           @map("approved_by_id")
  approvedByName   String?           @map("approved_by_name")
  approvedAt       DateTime?         @map("approved_at")
  disbursedAt      DateTime?         @map("disbursed_at")
  cancelledAt      DateTime?         @map("cancelled_at")
  cancelledById    String?           @map("cancelled_by_id")
  cancelledReason  String?           @map("cancelled_reason")
  syncedToSheets   Boolean           @default(false) @map("synced_to_sheets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payCategory         PayCategory?        @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  createdBy           User                @relation("BatchCreatedBy", fields: [createdById], references: [id])
  approvedBy          User?               @relation("BatchApprovedBy", fields: [approvedById], references: [id])
  items               BatchItem[]
  walletLedgerEntries WalletLedgerEntry[]
  payoutFundingWaits  PayoutFundingWait[]
  settlementBatch     SettlementBatch?

  // Lovable migration additions
  payoutBatchReference String? @map("payout_batch_reference")

  @@unique([workspaceId, batchRef])
  @@index([workspaceId, payoutStatus])
  @@map("batches")
}

// A batch line. Bank details + classification are SNAPSHOTS taken at approval time.
// outstanding = total − paidAmount (treat as 0 when paidAmount ≥ total − 0.5).
model BatchItem {
  id              String                @id @default(uuid())
  batchId         String                @map("batch_id")
  queueItemId     String?               @map("queue_item_id") // null for manual entries; split lines share it
  date            DateTime              @default(now()) @db.Date
  vendorId        String?               @map("vendor_id")
  vendorName      String                @map("vendor_name")
  vendorBank      String?               @map("vendor_bank")
  vendorBankCode  String?               @map("vendor_bank_code")
  vendorAcctNo    String?               @map("vendor_acct_no")
  vendorAcctName  String?               @map("vendor_acct_name")
  description     String
  bundleId        String?               @map("bundle_id")
  bundleLabel     String?               @map("bundle_label")
  units           Decimal               @default(1) @db.Decimal(12, 3)
  unitName        String?               @map("unit_name")
  unitAmount      Decimal               @default(0) @map("unit_amount") @db.Decimal(14, 2)
  total           Decimal               @db.Decimal(14, 2) // gross
  whtRate         Decimal               @default(0) @map("wht_rate") @db.Decimal(6, 4)
  whtAmount       Decimal               @default(0) @map("wht_amount") @db.Decimal(14, 2)
  netAmount       Decimal               @map("net_amount") @db.Decimal(14, 2)
  paidAmount      Decimal               @default(0) @map("paid_amount") @db.Decimal(14, 2)
  payoutStatus    BatchItemPayoutStatus @default(PENDING) @map("payout_status")
  payoutReference String?               @map("payout_reference")
  payoutMessage   String?               @map("payout_message")
  payCategoryId   String?               @map("pay_category_id")
  payCategoryName String?               @map("pay_category")
  coaTagId        String?               @map("coa_tag_id")
  coaTag          String?               @map("coa_tag")
  costCenterId    String?               @map("cost_center_id")
  locationId      String?               @map("location_id")
  pnlPeriod       String?               @map("pnl_period")
  isManual        Boolean               @default(false) @map("is_manual")
  returnedAt      DateTime?             @map("returned_at")
  returnedById    String?               @map("returned_by_id")
  /// Set by "Retry": failures recorded before this moment no longer mark the line FAILED.
  retriedAt       DateTime?             @map("retried_at")
  syncedToSheets  Boolean               @default(false) @map("synced_to_sheets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batch       Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  queueItem   QueueItem?        @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  vendor      Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payCategory PayCategory?      @relation(fields: [payCategoryId], references: [id], onDelete: SetNull)
  coaTagRef   CoaTag?           @relation(fields: [coaTagId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  payouts     BatchItemPayout[]
  whtLedger   WhtLedger[]

  // Lovable migration additions
  /// vendor_id as it was in Lovable when that vendor no longer exists (935 rows); vendorId is nulled, this keeps the trail.
  legacyVendorId    String?   @map("legacy_vendor_id")
  legacyStatus      String?   @map("legacy_status")
  attachmentGroupId String?   @map("attachment_group_id")
  requisitionId     String?   @map("requisition_id")
  queuedAt          DateTime? @map("queued_at")
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  paidById          String?   @map("paid_by_id")
  payStartedAt      DateTime? @map("pay_started_at")
  paidAt            DateTime? @map("paid_at")
  createdById       String?   @map("created_by_id")

  @@index([batchId])
  @@index([queueItemId])
  @@index([vendorId])
  @@map("batch_items")
}

// Payout ledger: one row per transfer leg attempt (VENDOR net leg, WHT leg) or statement match
// (reference "STMT-..."). The source of truth for "was this paid?" after an interrupted request.
model BatchItemPayout {
  id                       String       @id @default(uuid())
  workspaceId              String       @map("workspace_id")
  batchItemId              String       @map("batch_item_id")
  leg                      PayoutLeg    @default(VENDOR)
  amount                   Decimal      @db.Decimal(14, 2)
  status                   PayoutStatus @default(PENDING)
  reference                String       @unique
  destinationAccountNumber String?      @map("destination_account_number")
  destinationBankCode      String?      @map("destination_bank_code")
  destinationAccountName   String?      @map("destination_account_name")
  failureReason            String?      @map("failure_reason")
  providerResponse         Json?        @map("provider_response")
  initiatedById            String?      @map("initiated_by_id")
  completedAt              DateTime?    @map("completed_at")
  /// Monnify transfer reference. Equals `reference` unless several legs were aggregated into one
  /// transfer ("one transfer per vendor"), in which case they share it.
  transferReference        String?      @map("transfer_reference")
  /// Disburse request that created this leg (recovery after an interrupted request).
  clientRequestId          String?      @map("client_request_id")
  /// When the provider confirmed the final status (webhook or status query). A FAILED leg without
  /// it is "failed without a status check" and its line is not safe to pay again.
  statusCheckedAt          DateTime?    @map("status_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchItem BatchItem @relation(fields: [batchItemId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  message       String?
  payoutGroupId String? @map("payout_group_id")

  @@index([batchItemId])
  @@index([workspaceId, status])
  @@index([transferReference])
  @@index([clientRequestId])
  @@map("batch_item_payouts")
}

// ─── Wallet (funds a workspace disburses from) ─────────────────────────────

model WalletLedgerEntry {
  id            String                @id @default(uuid())
  workspaceId   String                @map("workspace_id")
  type          WalletTransactionType
  direction     LedgerDirection
  status        LedgerStatus          @default(COMPLETED)
  amount        Decimal               @db.Decimal(14, 2) // signed: + in, − out
  balanceBefore Decimal?              @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal?              @map("balance_after") @db.Decimal(14, 2)
  batchId       String?               @map("batch_id")
  reference     String?
  sourceType    String?               @map("source_type") // topup | payout | wht | manual ...
  sourceId      String?               @map("source_id")
  description   String?
  actorUserId   String?               @map("actor_user_id")
  postedAt      DateTime              @default(now()) @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  // Lovable migration additions
  /// Lovable wallet_ledger_entries.source_key: globally unique idempotency key for every posting.
  sourceKey String? @unique @map("source_key")
  metadata  Json?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, reference])
  @@map("wallet_ledger_entries")
}

model WalletTopup {
  id                 String       @id @default(uuid())
  workspaceId        String       @map("workspace_id")
  amount             Decimal      @db.Decimal(14, 2)
  reference          String       @unique // e.g. MNFY|...
  payerName          String?      @map("payer_name")
  payerBank          String?      @map("payer_bank")
  payerAccountNumber String?      @map("payer_account_number")
  source             TopupSource  @default(WEBHOOK)
  status             PayoutStatus @default(PENDING)
  paidAt             DateTime?    @map("paid_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  rawPayload Json? @map("raw_payload")

  @@index([workspaceId, createdAt])
  @@map("wallet_topups")
}

model WalletSweep {
  id                  String    @id @default(uuid())
  workspaceId         String    @map("workspace_id")
  /// Amount released from clearing in this check (Lovable released_amount).
  amount              Decimal   @default(0) @db.Decimal(14, 2)
  releasedAmount      Decimal   @default(0) @map("released_amount") @db.Decimal(14, 2)
  liveWalletBalance   Decimal?  @map("live_wallet_balance") @db.Decimal(14, 2)
  ledgerAvailable     Decimal   @default(0) @map("ledger_available") @db.Decimal(14, 2)
  clearing            Decimal   @default(0) @db.Decimal(14, 2)
  status              String    @default("ok") // ok | clearing | blocked
  reason              String?
  raw                 Json?
  monnifyReference    String?   @unique @map("monnify_reference")
  sourceAccountNumber String?   @map("source_account_number")
  sourceAccountName   String?   @map("source_account_name")
  matchedAt           DateTime? @map("matched_at")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("wallet_sweeps")
}

model PayoutFundingWait {
  id              String            @id @default(uuid())
  workspaceId     String            @map("workspace_id")
  batchId         String            @map("batch_id")
  requiredAmount  Decimal           @map("required_amount") @db.Decimal(14, 2)
  availableAmount Decimal           @map("available_amount") @db.Decimal(14, 2)
  status          FundingWaitStatus @default(WAITING)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  readyAtBlock Decimal   @default(0) @map("ready_at_block") @db.Decimal(14, 2)
  notifiedAt   DateTime? @map("notified_at")

  @@map("payout_funding_waits")
}

// ─── Withholding tax ────────────────────────────────────────────────────────

// Workspace default WHT rate by COA label (case-insensitive match, spec §6 step 3).
// workspaceId null = platform default.
model WhtRate {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  coa         String // COA / category label
  rate        Decimal  @db.Decimal(6, 4) // fraction 0–1
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, coa])
  @@map("wht_rates")
}

model WhtLedger {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  batchItemId String    @map("batch_item_id")
  vendorId    String?   @map("vendor_id")
  grossAmount Decimal   @map("gross_amount") @db.Decimal(14, 2)
  whtRate     Decimal   @map("wht_rate") @db.Decimal(6, 4) // fraction 0–1
  whtAmount   Decimal   @map("wht_amount") @db.Decimal(14, 2)
  taxPeriod   DateTime  @map("tax_period") // first of month withheld
  reference   String?   @unique
  remittedAt  DateTime? @map("remitted_at")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batchItem BatchItem @relation(fields: [batchItemId], references: [id], onDelete: Cascade)
  vendor    Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Lovable migration additions
  payoutGroupId         String?  @unique @map("payout_group_id")
  vendorName            String?  @map("vendor_name")
  coa                   String?
  netAmount             Decimal? @map("net_amount") @db.Decimal(14, 2)
  vendorPayoutReference String?  @map("vendor_payout_reference")
  whtPayoutReference    String?  @map("wht_payout_reference")
  remitStatus           String   @default("pending") @map("remit_status")

  @@index([workspaceId, taxPeriod])
  @@index([batchItemId])
  @@map("wht_ledger")
}

// ─── Receivables: customers, invoices ───────────────────────────────────────

model Customer {
  id           String  @id @default(uuid())
  workspaceId  String  @map("workspace_id")
  name         String
  email        String?
  phone        String?
  address      String?
  taxId        String? @map("tax_id")
  notes        String?
  isArchived   Boolean @default(false) @map("is_archived")
  mergedIntoId String? @map("merged_into_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credits       CustomerCredit[]
  invoices      Invoice[]
  recurrences   InvoiceRecurrence[]
  subscriptions CustomerSubscription[]

  @@index([workspaceId])
  @@map("customers")
}

model CustomerCredit {
  id                 String       @id @default(uuid())
  workspaceId        String       @map("workspace_id")
