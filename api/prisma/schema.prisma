  // Lovable migration additions
  currency    String  @default("NGN")
  createdById String? @map("created_by_id")

  @@index([workspaceId, customerId])
  @@map("customer_credits")
}

model InvoiceTemplate {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  notes       String?
  terms       String?
  currency    String?
  // Editor settings captured by "Save as template" (discount, tax-inclusive, late fee, early pay…)
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     InvoiceTemplateItem[]
  invoices  Invoice[]

  @@map("invoice_templates")
}

model InvoiceTemplateItem {
  id          String  @id @default(uuid())
  templateId  String  @map("template_id")
  productId   String? @map("product_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  vatRate     Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2) // percent
  whtRate     Decimal @default(0) @map("wht_rate") @db.Decimal(5, 2) // percent
  sortOrder   Int     @default(0) @map("sort_order")

  template InvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Lovable migration additions
  discountType  DiscountType? @map("discount_type")
  discountValue Decimal?      @map("discount_value") @db.Decimal(14, 2)

  @@map("invoice_template_items")
}

model Invoice {
  id                      String         @id @default(uuid())
  workspaceId             String         @map("workspace_id")
  docType                 InvoiceDocType @default(INVOICE) @map("doc_type")
  invoiceNumber           String?        @map("invoice_number") // null for quotes until converted
  quoteNumber             String?        @map("quote_number")
  quoteExpiresAt          DateTime?      @map("quote_expires_at")
  convertedFromQuoteId    String?        @map("converted_from_quote_id")
  customerId              String         @map("customer_id")
  customerAddress         String?        @map("customer_address")
  customerTin             String?        @map("customer_tin")
  workspaceTin            String?        @map("workspace_tin")
  status                  InvoiceStatus  @default(DRAFT)
  issueDate               DateTime       @map("issue_date")
  dueDate                 DateTime?      @map("due_date")
  dueDays                 Int?           @map("due_days")
  currency                String         @default("NGN")
  fxRate                  Decimal?       @map("fx_rate") @db.Decimal(18, 6)
  fxBaseCurrency          String?        @map("fx_base_currency")
  taxInclusive            Boolean        @default(false) @map("tax_inclusive")
  discountType            DiscountType?  @map("discount_type")
  discountValue           Decimal        @default(0) @map("discount_value") @db.Decimal(14, 2)
  discountAmount          Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal                Decimal        @db.Decimal(14, 2)
  vatTotal                Decimal        @default(0) @map("vat_total") @db.Decimal(14, 2)
  whtTotal                Decimal        @default(0) @map("wht_total") @db.Decimal(14, 2)
  total                   Decimal        @db.Decimal(14, 2)
  amountDue               Decimal        @default(0) @map("amount_due") @db.Decimal(14, 2)
  paidAmount              Decimal        @default(0) @map("paid_amount") @db.Decimal(14, 2)
  lateFeePercent          Decimal?       @map("late_fee_percent") @db.Decimal(5, 2)
  lateFeeFlat             Decimal?       @map("late_fee_flat") @db.Decimal(14, 2)
  lateFeeGraceDays        Int?           @map("late_fee_grace_days")
  earlyPayDiscountPercent Decimal?       @map("early_pay_discount_percent") @db.Decimal(5, 2)
  earlyPayDiscountDays    Int?           @map("early_pay_discount_days")
  lateFeeAmount           Decimal        @default(0) @map("late_fee_amount") @db.Decimal(14, 2)
  lateFeeAppliedAt        DateTime?      @map("late_fee_applied_at")
  earlyPayDiscountAmount  Decimal        @default(0) @map("early_pay_discount_amount") @db.Decimal(14, 2)
  notes                   String?
  terms                   String?
  templateId              String?        @map("template_id")
  recurrenceId            String?        @map("recurrence_id")
  collectionAccountNumber String?        @map("collection_account_number")
  collectionAccountName   String?        @map("collection_account_name")
  collectionBankName      String?        @map("collection_bank_name")
  collectionAccountRef    String?        @unique @map("collection_account_ref")
  shareToken              String?        @unique @map("share_token")
  sentAt                  DateTime?      @map("sent_at")
  voidedAt                DateTime?      @map("voided_at")
  createdById             String?        @map("created_by_id")
  syncedToSheets          Boolean        @default(false) @map("synced_to_sheets")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id])
  template           InvoiceTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recurrence         InvoiceRecurrence? @relation("RecurrenceInvoices", fields: [recurrenceId], references: [id], onDelete: SetNull)
  sourceOfRecurrence InvoiceRecurrence? @relation("RecurrenceSource")
  items              InvoiceItem[]
  payments           InvoicePayment[]
  sends              InvoiceSend[]
  sweeps             InvoiceSweep[]
  receipts           PaymentReceipt[]
  creditsApplied     CustomerCredit[]   @relation("CreditAppliedTo")
  creditsCreated     CustomerCredit[]   @relation("CreditSource")

  // Lovable migration additions
  taxRate                 Decimal   @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount               Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  paidAt                  DateTime? @map("paid_at")
  collectionProvisionedAt DateTime? @map("collection_provisioned_at")
  shareTokenCreatedAt     DateTime? @map("share_token_created_at")
  convertedAt             DateTime? @map("converted_at")
  fxLockedAt              DateTime? @map("fx_locked_at")
  ccEmails                String[]  @default([]) @map("cc_emails")

  @@unique([workspaceId, invoiceNumber])
  @@unique([workspaceId, quoteNumber])
  @@index([workspaceId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  productId   String? @map("product_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  vatRate     Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2) // percent
  whtRate     Decimal @default(0) @map("wht_rate") @db.Decimal(5, 2) // percent
  lineTotal   Decimal @default(0) @map("line_total") @db.Decimal(14, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Lovable migration additions
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(18, 2)
  whtAmount      Decimal       @default(0) @map("wht_amount") @db.Decimal(18, 2)
  discountType   DiscountType? @map("discount_type")
  discountValue  Decimal       @default(0) @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxInclusive   Boolean       @default(false) @map("tax_inclusive")

  @@map("invoice_items")
}

model InvoicePayment {
  id               String    @id @default(uuid())
  invoiceId        String    @map("invoice_id")
  amount           Decimal   @db.Decimal(14, 2)
  monnifyReference String?   @map("monnify_reference") // payment_reference
  method           String? // TRANSFER | CASH | CARD | MONNIFY | CREDIT
  notes            String?
  paidAt           DateTime  @default(now()) @map("paid_at") // payment_date
  settledAt        DateTime? @map("settled_at")
  recordedById     String?   @map("recorded_by_id")

  invoice  Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receipts PaymentReceipt[]

  @@index([invoiceId])
  @@map("invoice_payments")
}

// Generates invoices on a cadence. templateItems = [{description, quantity, unitPrice, vatRate,
// whtRate, productId?}]. invoiceId (optional) = the invoice it was created from.
model InvoiceRecurrence {
  id            String             @id @default(uuid())
  workspaceId   String             @map("workspace_id")
  customerId    String?            @map("customer_id")
  invoiceId     String?            @unique @map("invoice_id")
  interval      RecurrenceInterval
  nextRunAt     DateTime           @map("next_run_at")
  endsAt        DateTime?          @map("ends_at")
  dueDays       Int                @default(14) @map("due_days")
  currency      String             @default("NGN")
  notes         String?
  terms         String?
  templateItems Json?              @map("template_items")
  lastRunAt     DateTime?          @map("last_run_at")
  isActive      Boolean            @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice   Invoice?  @relation("RecurrenceSource", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoices  Invoice[] @relation("RecurrenceInvoices")

  @@index([workspaceId, isActive])
  @@map("invoice_recurrences")
}

// Per-series numbering (next_invoice_number(prefix)). Increment atomically with
// update { nextValue: { increment: 1 } } inside a transaction.
model InvoiceSequence {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  prefix      String
  nextValue   Int    @default(1) @map("next_value")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, prefix])
  @@map("invoice_sequences")
}

model InvoiceSend {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  channel   String // EMAIL | WHATSAPP | SMS
  sentTo    String   @map("sent_to")
  cc        String?
  sentAt    DateTime @default(now()) @map("sent_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  status            String  @default("sent")
  message           String?
  error             String?
  providerMessageId String? @map("provider_message_id")
  sentById          String? @map("sent_by_id")

  @@map("invoice_sends")
}

// Auto-sweep of collected funds out of an invoice's collection account.
model InvoiceSweep {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  sheetRowReference String?  @map("sheet_row_reference")
  amount            Decimal  @db.Decimal(14, 2)
  reference         String?  @unique
  status            String? // PENDING | SUCCESS | FAILED
  matchedAt         DateTime @default(now()) @map("matched_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_sweeps")
}

model PaymentReceipt {
  id               String   @id @default(uuid())
  invoiceId        String   @map("invoice_id")
  invoicePaymentId String?  @map("invoice_payment_id")
  receiptNumber    String   @map("receipt_number")
  pdfUrl           String?  @map("pdf_url")
  createdAt        DateTime @default(now()) @map("created_at")

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoicePayment InvoicePayment? @relation(fields: [invoicePaymentId], references: [id])

  @@map("payment_receipts")
}

// Invoicing product catalog.
model Product {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  sku         String?
  unitName    String?  @map("unit_name")
  unitPrice   Decimal  @default(0) @map("unit_price") @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2) // VAT percent
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoiceItems  InvoiceItem[]
  templateItems InvoiceTemplateItem[]

  @@unique([workspaceId, name])
  @@map("products")
}

// ─── Platform billing (Paid in Full billing its own workspaces) ────────────

model BillingPlan {
  id           String   @id @default(uuid())
  tier         PlanTier @unique
  name         String
  priceMonthly Decimal  @map("price_monthly") @db.Decimal(14, 2)
  features     Json

  subscriptions WorkspaceSubscription[]

  // Lovable migration additions
  code                String?  @unique
  productType         String?  @map("product_type") // managed | standalone
  description         String?
  currency            String   @default("NGN")
  setupFee            Decimal  @default(0) @map("setup_fee") @db.Decimal(14, 2)
  prepayMonths        Int?     @map("prepay_months")
  prepayMonthlyAmount Decimal? @map("prepay_monthly_amount") @db.Decimal(14, 2)
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")

  @@map("billing_plans")
}

model WorkspaceSubscription {
  id                 String   @id @default(uuid())
  workspaceId        String   @unique @map("workspace_id")
  billingPlanId      String   @map("billing_plan_id")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace      Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingPlan    BillingPlan                 @relation(fields: [billingPlanId], references: [id])
  payments       BillingPayment[]
  chargeAttempts SubscriptionChargeAttempt[]
  dunningState   SubscriptionDunningState?

  // Lovable migration additions
  currency       String    @default("NGN")
  prepayMonths   Int?      @map("prepay_months")
  graceUntil     DateTime? @map("grace_until") @db.Date
  setupFeePaidAt DateTime? @map("setup_fee_paid_at")
  trialGranted   Boolean   @default(false) @map("trial_granted")
  /// Lovable workspace_subscriptions.client_status (trial | active | suspended ...)
  clientStatus   String?   @map("client_status")

  @@map("workspace_subscriptions")
}

model BillingPayment {
  id                      String   @id @default(uuid())
  workspaceSubscriptionId String   @map("workspace_subscription_id")
  amount                  Decimal  @db.Decimal(14, 2)
  monnifyReference        String?  @unique @map("monnify_reference")
  paidAt                  DateTime @default(now()) @map("paid_at")

  workspaceSubscription WorkspaceSubscription @relation(fields: [workspaceSubscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_payments")
}

model SubscriptionChargeAttempt {
  id                      String   @id @default(uuid())
  workspaceSubscriptionId String   @map("workspace_subscription_id")
  amount                  Decimal  @db.Decimal(14, 2)
  succeeded               Boolean  @default(false)
  failureReason           String?  @map("failure_reason")
  attemptedAt             DateTime @default(now()) @map("attempted_at")

  workspaceSubscription WorkspaceSubscription @relation(fields: [workspaceSubscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_charge_attempts")
}

model SubscriptionDunningState {
  id                      String    @id @default(uuid())
  workspaceSubscriptionId String    @unique @map("workspace_subscription_id")
  consecutiveFailures     Int       @default(0) @map("consecutive_failures")
  nextRetryAt             DateTime? @map("next_retry_at")
  suspendedAt             DateTime? @map("suspended_at")

  workspaceSubscription WorkspaceSubscription @relation(fields: [workspaceSubscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_dunning_state")
}

// Client subscription: a plan the workspace charges its own customer, collected via an auto-debit
// mandate (card token or bank direct debit) authorised on the public /m/:token page.
model CustomerSubscription {
  id                 String                     @id @default(uuid())
  workspaceId        String                     @map("workspace_id")
  customerId         String                     @map("customer_id")
  planName           String?                    @map("plan_name")
  description        String?
  interval           RecurrenceInterval // frequency
  amount             Decimal                    @db.Decimal(14, 2)
  status             CustomerSubscriptionStatus @default(PENDING_MANDATE)
  authorisationToken String?                    @unique @map("authorisation_token")
  mandateType        MandateType?               @map("mandate_type")
  mandateId          String?                    @map("mandate_id")
  mandateReference   String?                    @map("mandate_reference")
  cardLast4          String?                    @map("card_last4")
  cardToken          String?                    @map("card_token") // encrypted
  // Direct-debit authorisation details from /m/:token: { bankCode, bankName, accountNumber, phone, address }
  mandateDetails     Json?                      @map("mandate_details")
  nextRunAt          DateTime                   @map("next_run_at") // next charge
  lastChargedAt      DateTime?                  @map("last_charged_at")
  authorisedAt       DateTime?                  @map("authorised_at")
  cancelledAt        DateTime?                  @map("cancelled_at")
  isActive           Boolean                    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  charges   CustomerSubscriptionCharge[]

  // Lovable migration additions
  currency    String    @default("NGN")
  billingDay  Int?      @map("billing_day")
  startDate   DateTime? @map("start_date") @db.Date
  createdById String?   @map("created_by_id")

  @@index([workspaceId])
  @@map("customer_subscriptions")
}

model CustomerSubscriptionCharge {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  amount         Decimal      @db.Decimal(14, 2)
  status         ChargeStatus @default(PENDING)
  reference      String       @unique
  failureReason  String?      @map("failure_reason")
  feeAmount      Decimal?     @map("fee_amount") @db.Decimal(14, 2)
  netAmount      Decimal?     @map("net_amount") @db.Decimal(14, 2)
  attemptedAt    DateTime     @default(now()) @map("attempted_at")
  settledAt      DateTime?    @map("settled_at")

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("customer_subscription_charges")
}

// ─── Settlement reconciliation ──────────────────────────────────────────────

model SettlementBatch {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  batchId              String    @unique @map("batch_id")
  monnifySettlementRef String?   @map("monnify_settlement_ref")
  expectedAmount       Decimal   @map("expected_amount") @db.Decimal(14, 2)
  settledAmount        Decimal?  @map("settled_amount") @db.Decimal(14, 2)
  settledAt            DateTime? @map("settled_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     Batch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  items     SettlementBatchItem[]

  @@map("settlement_batches")
}

model SettlementBatchItem {
  id                 String               @id @default(uuid())
  settlementBatchId  String               @map("settlement_batch_id")
  batchItemPayoutRef String               @map("batch_item_payout_ref")
  amount             Decimal              @db.Decimal(14, 2)
  status             SettlementItemStatus @default(UNMATCHED)

  settlementBatch SettlementBatch @relation(fields: [settlementBatchId], references: [id], onDelete: Cascade)

  @@map("settlement_batch_items")
}

// ─── Notifications, email, push ─────────────────────────────────────────────

model NotificationPref {
  id          String  @id @default(uuid())
  workspaceId String  @map("workspace_id")
  userId      String  @map("user_id")
  channel     String // IN_APP | EMAIL | PUSH | WHATSAPP
  event       String // queue_added | batch_pending_approval | disbursement_result
  isEnabled   Boolean @default(true) @map("is_enabled")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, channel, event])
  @@map("notification_prefs")
}

model PushSubscription {
  id          String       @id @default(uuid())
  workspaceId String       @map("workspace_id")
  userId      String       @map("user_id")
  platform    PushPlatform @default(WEB)
  endpoint    String       @unique
  p256dhKey   String       @map("p256dh_key")
  authKey     String       @map("auth_key")
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model EmailSendLog {
  id        String   @id @default(uuid())
  toEmail   String   @map("to_email")
  template  String
  status    String // SENT | FAILED | BOUNCED
  createdAt DateTime @default(now()) @map("created_at")

  // Lovable migration additions
  messageId    String? @map("message_id")
  errorMessage String? @map("error_message")
  metadata     Json?

  @@map("email_send_log")
}

model EmailSendState {
  id         String   @id @default(uuid())
  toEmail    String   @map("to_email")
  template   String
  lastSentAt DateTime @map("last_sent_at")

  @@unique([toEmail, template])
  @@map("email_send_state")
}

model EmailUnsubscribeToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_unsubscribe_tokens")
}

model SuppressedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  reason    String // BOUNCE | COMPLAINT | UNSUBSCRIBE
  createdAt DateTime @default(now()) @map("created_at")

  // Lovable migration additions
  metadata Json?

  @@map("suppressed_emails")
}

// ─── Config / audit / misc ──────────────────────────────────────────────────

// Per-workspace key/value settings (spec app_config): requisitions_enabled, sheets_url,
// batches_tab_name, business_units_required, session_timeout_minutes,
// require_reauth_for_disbursement, wht_account, sweep_*, payment_account, setup_*_done, ...
// COA tags are NOT stored here; see CoaTag.
model AppConfig {
  workspaceId String   @map("workspace_id")
  key         String
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Lovable migration additions
  isSensitive Boolean @default(true) @map("is_sensitive")

  @@id([workspaceId, key])
  @@map("app_config")
}

// Platform-wide key/value settings (super-admin only).
model PlatformConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

// actor = userId + actorEmail snapshot; target = human-readable subject (e.g. batch ref, vendor
// name); entityType/entityId = optional machine link.
model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?  @map("workspace_id")
  userId      String?  @map("user_id") // actor_user_id
  actorEmail  String?  @map("actor_email")
  action      String
  target      String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@map("audit_log")
}

model ClientError {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  url       String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  // Lovable migration additions
  source      String?
  workspaceId String? @map("workspace_id")
  userId      String? @map("user_id")
  userEmail   String? @map("user_email")
  severity    String  @default("error")
  metadata    Json?

  @@map("client_errors")
}

// Backs runIdempotent() in api/src/common/idempotent.ts.
model IdempotencyKey {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  action         String
  key            String
  resultSnapshot Json?    @map("result_snapshot")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, action, key])
  @@map("idempotency_keys")
}

// ─── Procurement approvals (Lovable tables with no earlier Prisma model) ───────────────────

/// Who may approve requisitions in a role (accountant | procurement_head | general_manager).
model ProcurementApprover {
  id           String   @id @default(uuid())
  workspaceId  String   @map("workspace_id")
  userId       String   @map("user_id")
  approvalRole String   @map("approval_role")
  /// Lovable procurement_approvers.is_backup: a standby approver used when the primary is unavailable.
  isBackup     Boolean  @default(false) @map("is_backup")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, approvalRole])
  @@map("procurement_approvers")
}

/// One approval by one approver in one approval round of a requisition.
model RequisitionApproval {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  requisitionId  String   @map("requisition_id")
  approvalRound  Int      @default(0) @map("approval_round")
  approverUserId String   @map("approver_user_id")
  approvalRole   String   @map("approval_role")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver    User        @relation("RequisitionApprovalApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([requisitionId, approvalRound, approvalRole])
  @@unique([requisitionId, approvalRound, approverUserId])
  @@index([workspaceId])
  @@map("requisition_approvals")
}

/// Goods-received / work-completion confirmation, signed twice (first and second signatory).
model GoodsReceipt {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  requisitionId String    @unique @map("requisition_id")
  kind          String
  receivedQty   Decimal?  @map("received_qty") @db.Decimal(14, 3)
  condition     String?
  notes         String?
  firstById     String?   @map("first_by_id")
  firstAt       DateTime? @map("first_at")
  secondById    String?   @map("second_by_id")
  secondAt      DateTime? @map("second_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("goods_receipts")
}
