const feats = [
  {
    title: 'Batch disbursement',
    body: 'Pay 40+ vendors in a single approved batch via Monnify.',
    path: 'M12 2v20M2 7l10-5 10 5M2 7v10l10 5 10-5V7M2 7l10 5 10-5',
  },
  {
    title: 'Category + budget tagging',
    body: 'Every line item categorised at entry. Month-end is just a download.',
    path: 'M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01',
  },
  {
    title: 'Role-based approvals',
    body: 'Poster, Approver, Admin. Full audit trail on every disbursement.',
    path: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z',
  },
  {
    title: 'Spend reports',
    body: 'Spend by COA, vendor, and month. Charts your CFO will actually open.',
    path: 'M3 3v18h18M7 15l4-5 3 3 5-7',
  },
  {
    title: 'Vendor directory',
    body: 'Bank-validated vendor accounts. No more screenshot of account numbers.',
    path: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    title: 'CSV import',
    body: 'Bulk-load 200 invoices from your existing sheet in 10 seconds.',
    path: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6ZM14 2v6h6M9 13h6M9 17h6',
