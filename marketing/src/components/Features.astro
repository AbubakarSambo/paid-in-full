---

<section id="features" class="max-w-6xl mx-auto px-5 py-20 md:py-28">
  <div class="max-w-2xl mb-12">
    <p class="text-xs uppercase tracking-widest text-gold font-semibold mb-3">Features</p>
    <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">
      Everything your finance team has been hacking together.
    </h2>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      feats.map((f) => (
        <div class="p-6 rounded-2xl bg-surface border border-border">
          <div class="size-10 rounded-xl bg-gold/10 grid place-content-center mb-4">
            <svg class="size-5 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d={f.path} stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg mb-1.5">{f.title}</h3>
          <p class="text-text-dim text-sm leading-relaxed">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>
