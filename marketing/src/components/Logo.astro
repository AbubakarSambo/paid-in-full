---
interface Props {
  size?: number
  class?: string
}
const { size = 32, class: klass = '' } = Astro.props
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Paid in Full"
>
  <rect width="32" height="32" rx="9" fill="#050608" />
  <rect x="0.5" y="0.5" width="31" height="31" rx="8.5" stroke="#F4B942" stroke-opacity="0.35" />
  <path
    d="M9 23V9h7.2c2.98 0 5.1 2 5.1 4.85 0 2.86-2.12 4.85-5.1 4.85H12.7V23H9Zm3.7-7.2h3.1c1.24 0 2.1-.79 2.1-1.95 0-1.16-.86-1.95-2.1-1.95h-3.1v3.9Z"
    fill="#F4B942"
  />
</svg>
