---
const items = [
  { title: "Spreadsheets + bank portals + WhatsApp", body: "Three tools, one payment. Reconciliation takes days." },
  { title: "No approval trail", body: "When ₦4M leaves the account, who approved it? Nobody can say." },
  { title: "Untagged spend", body: "Month-end becomes detective work because nothing was categorised at source." },
]
---

<section class="max-w-6xl mx-auto px-5 py-20 md:py-28">
  <div class="max-w-2xl mb-12">
    <p class="text-xs uppercase tracking-widest text-gold font-semibold mb-3">The problem</p>
    <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">
      Vendor payments shouldn't take a Tuesday afternoon.
    </h2>
  </div>
  <div class="grid md:grid-cols-3 gap-5">
    {
      items.map((it) => (
        <div class="p-6 rounded-2xl bg-surface border border-border">
          <h3 class="font-display font-bold text-lg mb-2">{it.title}</h3>
          <p class="text-text-dim text-sm leading-relaxed">{it.body}</p>
        </div>
      ))
    }
  </div>
</section>
